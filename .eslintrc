{
  "root": true,
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": true,
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "extends": "airbnb",
  "env": {
    "node": true,
    "es6": true
  },
  "plugins": [
    "prefer-object-spread"
  ],
  "rules": {
    "new-cap": 0,
    "no-use-before-define": 0,
    "arrow-body-style": 0,
    "eqeqeq": [2, "allow-null"],
    "no-console": 0,
    "arrow-parens": 0,
    "prefer-object-spread/prefer-object-spread": 2,
    "import/no-import-module-exports": 0
  },
  "globals": {
    "__DEV__": true
  }
}
