{
  "root": true,
  "parser": "@babel/eslint-parser",
  "extends": "airbnb-base",
  "env": {
    "node": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "requireConfigFile": true
  },
  "rules": {
    "new-cap": 0,
    "no-use-before-define": 0,
    "arrow-body-style": 0,
    "eqeqeq": [2, "allow-null"],
    "no-console": 0,
    "arrow-parens": 0,
    "object-shorthand": ["error", "always"]
  },
  "globals": {
    "__DEV__": true
  }
}
